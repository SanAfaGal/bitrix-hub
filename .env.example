API_PORT=8000

# URL pública por la que los clientes finales llegan a este hub (ej. desde un
# enlace enviado por WhatsApp) — sin `/` final.
HUB_PUBLIC_BASE_URL=https://tu-dominio-bitrix-hub.com

BITRIX_WEBHOOK_URL=https://tu-dominio.bitrix24.com/rest/1/tu_token/

XPOSURE_BASE_URL=https://tu-dominio-xposure.com
XPOSURE_USERNAME=tu_usuario
XPOSURE_PASSWORD=tu_password

# ── Waha (contenedor propio, definido en docker-compose.yml) ─────────────────

WAHA_PORT=3000

# "waha" resuelve por hostname porque api y waha están en el mismo
# docker-compose.yml. Corriendo bitrix-hub suelto con `uv run uvicorn`
# (sin Docker), override puntual: WAHA_BASE_URL=http://localhost:3000
WAHA_BASE_URL=http://waha:3000
WAHA_PUBLIC_URL=http://localhost:3000
WAHA_SESSION=default

WAHA_API_KEY=your_api_key_here

WAHA_DASHBOARD_ENABLED=true
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=your_secure_password_here

WHATSAPP_SWAGGER_ENABLED=true
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=your_secure_password_here

WHATSAPP_DEFAULT_ENGINE=GOWS

WAHA_WORKER_ID=waha-main
WAHA_NAMESPACE=all
WAHA_CLIENT_DEVICE_NAME=WAHA
WAHA_STORE_TYPE=FILE

TZ=America/Bogota

WAHA_LOG_FORMAT=JSON
WAHA_LOG_LEVEL=info
WAHA_PRINT_QR=false

WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_LIFETIME=0
WHATSAPP_FILES_FOLDER=/app/.media

# WHATSAPP_HOOK_URL=http://api:8000/webhook/waha-message
# WHATSAPP_HOOK_EVENTS=session.status,message,message.reaction

# ── Límites de recursos (docker-compose.yml, deploy.resources.limits) ────────
# Pensados para un VPS chico. docker-compose.override.yml (dev local) no los
# aplica — corren sin límite en tu máquina.
API_CPU_LIMIT=1
API_MEMORY_LIMIT=512M
WAHA_CPU_LIMIT=2
WAHA_MEMORY_LIMIT=2G
