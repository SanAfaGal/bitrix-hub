# ── General ────────────────────────────────────────────────────────────────
API_PORT=8000

# URL pública por la que los clientes finales llegan a este hub (ej. desde un
# enlace enviado por WhatsApp) — sin `/` final.
HUB_PUBLIC_BASE_URL=https://tu-dominio-bitrix-hub.com

# ── CRM (Bitrix) ───────────────────────────────────────────────────────────
# CRM activo detrás de app.crm.protocol.CrmClient. Hoy el único soportado es "bitrix".
CRM_PROVIDER=bitrix

# Secreto para firmar el deal_id del link de Autorización de Corretaje (HMAC,
# sin expiración) — evita que alguien adivine/itere deal_id en la URL.
FORM_LINK_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

BITRIX_WEBHOOK_URL=https://tu-dominio.bitrix24.com/rest/1/tu_token/

# ID de la carpeta "Autorizaciones de corretaje" dentro del Drive del grupo
# de trabajo "Ventas" (workgroup id 184), donde se guardan los PDFs de
# Autorización de Corretaje firmados. El webhook necesita el scope "disk"
# habilitado y su usuario debe ser miembro del grupo "Ventas".
BITRIX_DRIVE_FOLDER_ID=596346

# ── Xposure ────────────────────────────────────────────────────────────────
XPOSURE_BASE_URL=https://tu-dominio-xposure.com
XPOSURE_USERNAME=tu_usuario
XPOSURE_PASSWORD=tu_password

# ── Waha (contenedor propio, definido en docker-compose.yml) ─────────────────

WAHA_PORT=3000

# "waha" resuelve por hostname porque api y waha están en el mismo
# docker-compose.yml. Corriendo bitrix-hub suelto con `uv run uvicorn`
# (sin Docker), override puntual: WAHA_BASE_URL=http://localhost:3000
WAHA_BASE_URL=http://waha:3000
WAHA_PUBLIC_URL=http://localhost:3000
WAHA_SESSION=default

WAHA_API_KEY=your_api_key_here

WAHA_DASHBOARD_ENABLED=true
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=your_secure_password_here

WHATSAPP_SWAGGER_ENABLED=true
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=your_secure_password_here

WHATSAPP_DEFAULT_ENGINE=GOWS

WAHA_WORKER_ID=waha-main
WAHA_NAMESPACE=all
WAHA_CLIENT_DEVICE_NAME=WAHA
WAHA_STORE_TYPE=FILE

TZ=America/Bogota

WAHA_LOG_FORMAT=JSON
WAHA_LOG_LEVEL=info
WAHA_PRINT_QR=false

WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_LIFETIME=0
WHATSAPP_FILES_FOLDER=/app/.media

# Necesario solo si activás el bot conversacional (ver sección abajo) — le
# dice a Waha que reenvíe los eventos de mensaje a este hub. Si configurás
# WHATSAPP_WEBHOOK_SECRET más abajo, agregá "?secret=<ese mismo valor>" acá
# al final de la URL, si no cualquiera que la descubra puede disparar
# llamadas al LLM y crear deals en Bitrix a nombre de un cliente inventado.
WHATSAPP_HOOK_URL=http://api:8000/webhook/waha-message
WHATSAPP_HOOK_EVENTS=message

# ── Transcripción de audio (whisper-asr-webservice, contenedor propio) ──────
# "whisper" resuelve por hostname porque api y whisper están en el mismo
# docker-compose.yml. Corriendo bitrix-hub suelto con `uv run uvicorn`
# (sin Docker), override puntual: TRANSCRIPTION_BASE_URL=http://localhost:9000
TRANSCRIPTION_BASE_URL=http://whisper:9000
TRANSCRIPTION_LANGUAGE=es

# Modelo de whisper (tiny/base/small/medium/large) — a mayor tamaño, mejor
# precisión pero más lento en CPU. base es un buen punto de partida.
WHISPER_MODEL=base

# ── LLM (app/llm/, cualquier proveedor compatible con la API de OpenAI) ──────
# Cliente genérico: sirve para OpenAI y para cualquier otro proveedor que
# hable el mismo protocolo (Groq, Together, DeepSeek, OpenRouter, Azure
# OpenAI, un modelo local con Ollama/vLLM, etc.) — solo cambiando
# LLM_BASE_URL y LLM_MODEL, sin tocar código.

# Obligatoria si el bot está habilitado (ver abajo).
LLM_API_KEY=sk-tu-api-key

# Vacío = usa el endpoint de OpenAI. Para otro proveedor, su URL base
# compatible con /chat/completions, ej.:
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama local: http://localhost:11434/v1
LLM_BASE_URL=

# Modelo a usar (nombre según el proveedor de LLM_BASE_URL). Default:
# gpt-4o-mini (OpenAI, rápido y barato, alcanza para FAQ/soporte).
LLM_MODEL=gpt-4o-mini

# Fallback model si el primario falla (opcional). Ej.: mixtral-8x7b-32768 en Groq.
# Requiere LLM_FALLBACK_BASE_URL también.
# LLM_FALLBACK_MODEL=mixtral-8x7b-32768

# Base URL del fallback model (opcional, solo si LLM_FALLBACK_MODEL está set).
# Ej. para Groq: https://api.groq.com/openai/v1
# LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1

# API key del proveedor del fallback (opcional). Necesaria si el fallback es
# un proveedor distinto al primario (ej. Groq en vez de OpenAI) — si se
# omite, se reintenta con LLM_API_KEY, que solo funciona si ambos comparten
# la misma key (mismo proveedor, o mismo billing account).
# LLM_FALLBACK_API_KEY=gsk-tu-api-key-de-groq

# ── Panel admin (app/admin/) — plantillas y comportamiento del bot ─────────
# Usuario/clave único compartido con el equipo comercial (sin apps de
# terceros). Cambiar por credenciales reales antes de exponerlo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esto-por-una-clave-segura

# Firma la cookie de sesión del panel — cambiar por un secreto largo y
# aleatorio en producción (sin esto, cae a un secreto de desarrollo inseguro).
ADMIN_SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ── MySQL ──────────────────────────────────────────────────────────────────
# Guarda las plantillas de mensajes y el comportamiento del bot
# (app/message_templates/), editables desde el panel admin. El resto del
# storage del bot (historial de conversación) sigue en SQLite, ver
# WHATSAPP_BOT_DB_PATH más abajo.
#
# El contenedor mysql (+ adminer para inspeccionarlo en
# http://localhost:${ADMINER_PORT}) solo vive en docker-compose.override.yml
# (desarrollo local) — en producción MYSQL_HOST/MYSQL_PORT deben apuntar a un
# MySQL externo/gestionado aparte, no a este compose.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=bitrix_hub
MYSQL_USER=bitrix_hub
MYSQL_PASSWORD=cambia-esto-por-una-clave-segura
# Solo la usa el contenedor de MySQL (override) para inicializar la base (no la app).
MYSQL_ROOT_PASSWORD=cambia-esto-por-una-clave-segura
# Puerto local del panel web de adminer (solo dev, ver docker-compose.override.yml).
ADMINER_PORT=8080

# ── Bot conversacional de WhatsApp (experimental) ─────────────────────────
# Apagado por defecto. El webhook /webhook/waha-message siempre recibe los
# eventos de Waha (si WHATSAPP_HOOK_URL está configurado arriba), pero con
# WHATSAPP_BOT_ENABLED=false los ignora sin llamar al LLM ni responder.
#
# Cuando está habilitado, los datos del inmueble que el cliente cuenta
# (tipo, dirección, sector/zona/ciudad, precio esperado, matrícula) se
# guardan directo en un deal de consignación en Bitrix (pipeline/CATEGORY_ID
# 34, hardcodeado en app/bitrix/fields.py — no requiere variable de entorno)
# — no en memoria ni en comentarios. Ver la sección del bot en README.md.
WHATSAPP_BOT_ENABLED=false

# Secreto compartido para validar que quien llama a /webhook/waha-message es
# realmente Waha (query param ?secret=...). Vacío = sin validación, solo
# aceptable en desarrollo. Configurá esto antes de encender el bot con
# tráfico real, y agregá el mismo valor al final de WHATSAPP_HOOK_URL arriba.
WHATSAPP_WEBHOOK_SECRET=

# Cuántos turnos (usuario+asistente) de historial mandarle al LLM como
# contexto de la conversación (ver app/flows/whatsapp_bot.py).
WHATSAPP_BOT_MAX_HISTORY_TURNS=4

# El system prompt (comportamiento del bot) y los textos de bienvenida ya
# no se configuran por env var — se editan desde el panel admin en
# /admin/templates (ver app/message_templates/store.py para los defaults).

# Archivo SQLite donde se persisten el historial de turnos y el deal_id por
# chat (sobreviven a un restart/deploy) — ver app/flows/whatsapp_bot_store.py.
WHATSAPP_BOT_DB_PATH=data/whatsapp_bot.db

# Opcional, para probar en desarrollo sin exponer el bot a todo el mundo:
# lista separada por comas de números permitidos (código de país + número,
# sin "+", mismo formato que app.waha.phone.from_chat_id). Vacío (default)
# no restringe nada.
# WHATSAPP_BOT_ALLOWED_NUMBERS=573001112233,573004445566

# ── Límites de recursos (docker-compose.yml, deploy.resources.limits) ────────
# Pensados para un VPS chico. docker-compose.override.yml (dev local) no los
# aplica — corren sin límite en tu máquina.
API_CPU_LIMIT=1
API_MEMORY_LIMIT=512M
WAHA_CPU_LIMIT=2
WAHA_MEMORY_LIMIT=2G
WHISPER_CPU_LIMIT=2
WHISPER_MEMORY_LIMIT=2G

# ── Red Docker (docker-compose.yml, networks.default) ────────────────────────
# En producción los tres servicios se conectan a una red externa compartida
# del VPS (red_proyectos) para que un reverse proxy común los alcance. En
# dev esa red no existe, así que se deja DOCKER_NETWORK_EXTERNAL=false y
# compose crea su propia red para este proyecto.
DOCKER_NETWORK_NAME=bitrix-hub
DOCKER_NETWORK_EXTERNAL=false
# En producción:
# DOCKER_NETWORK_NAME=red_proyectos
# DOCKER_NETWORK_EXTERNAL=true
