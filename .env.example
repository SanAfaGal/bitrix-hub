# ── General ────────────────────────────────────────────────────────────────
API_PORT=8000

# URL pública por la que los clientes finales llegan a este hub (ej. desde un
# enlace enviado por WhatsApp) — sin `/` final.
HUB_PUBLIC_BASE_URL=https://tu-dominio-bitrix-hub.com

# ── CRM (Bitrix) ───────────────────────────────────────────────────────────
# CRM activo detrás de app.crm.protocol.CrmClient. Hoy el único soportado es "bitrix".
CRM_PROVIDER=bitrix

# Secreto para firmar el deal_id del link de Autorización de Corretaje (HMAC,
# sin expiración) — evita que alguien adivine/itere deal_id en la URL.
FORM_LINK_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

BITRIX_WEBHOOK_URL=https://tu-dominio.bitrix24.com/rest/1/tu_token/

# ID de la carpeta "Autorizaciones de corretaje" dentro del Drive del grupo
# de trabajo "Ventas" (workgroup id 184), donde se guardan los PDFs de
# Autorización de Corretaje firmados. El webhook necesita el scope "disk"
# habilitado y su usuario debe ser miembro del grupo "Ventas".
BITRIX_DRIVE_FOLDER_ID=596346

# ── Xposure ────────────────────────────────────────────────────────────────
XPOSURE_BASE_URL=https://tu-dominio-xposure.com
XPOSURE_USERNAME=tu_usuario
XPOSURE_PASSWORD=tu_password

# ── Waha (contenedor propio, definido en docker-compose.yml) ─────────────────

WAHA_PORT=3000

# "waha" resuelve por hostname porque api y waha están en el mismo
# docker-compose.yml. Corriendo bitrix-hub suelto con `uv run uvicorn`
# (sin Docker), override puntual: WAHA_BASE_URL=http://localhost:3000
WAHA_BASE_URL=http://waha:3000
WAHA_PUBLIC_URL=http://localhost:3000
WAHA_SESSION=default

WAHA_API_KEY=your_api_key_here

WAHA_DASHBOARD_ENABLED=true
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=your_secure_password_here

WHATSAPP_SWAGGER_ENABLED=true
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=your_secure_password_here

WHATSAPP_DEFAULT_ENGINE=GOWS

WAHA_WORKER_ID=waha-main
WAHA_NAMESPACE=all
WAHA_CLIENT_DEVICE_NAME=WAHA
WAHA_STORE_TYPE=FILE

TZ=America/Bogota

WAHA_LOG_FORMAT=JSON
WAHA_LOG_LEVEL=info
WAHA_PRINT_QR=false

WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_LIFETIME=0
WHATSAPP_FILES_FOLDER=/app/.media

# Necesario solo si activás el bot conversacional (ver sección abajo) — le
# dice a Waha que reenvíe los eventos de mensaje a este hub.
WHATSAPP_HOOK_URL=http://api:8000/webhook/waha-message
WHATSAPP_HOOK_EVENTS=message

# ── LLM (app/llm/, cualquier proveedor compatible con la API de OpenAI) ──────
# Cliente genérico: sirve para OpenAI y para cualquier otro proveedor que
# hable el mismo protocolo (Groq, Together, DeepSeek, OpenRouter, Azure
# OpenAI, un modelo local con Ollama/vLLM, etc.) — solo cambiando
# LLM_BASE_URL y LLM_MODEL, sin tocar código.

# Obligatoria si el bot está habilitado (ver abajo).
LLM_API_KEY=sk-tu-api-key

# Vacío = usa el endpoint de OpenAI. Para otro proveedor, su URL base
# compatible con /chat/completions, ej.:
#   Groq:        https://api.groq.com/openai/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama local: http://localhost:11434/v1
LLM_BASE_URL=

# Modelo a usar (nombre según el proveedor de LLM_BASE_URL). Default:
# gpt-4o-mini (OpenAI, rápido y barato, alcanza para FAQ/soporte).
LLM_MODEL=gpt-4o-mini

# ── Bot conversacional de WhatsApp (experimental) ─────────────────────────
# Apagado por defecto. El webhook /webhook/waha-message siempre recibe los
# eventos de Waha (si WHATSAPP_HOOK_URL está configurado arriba), pero con
# WHATSAPP_BOT_ENABLED=false los ignora sin llamar al LLM ni responder.
#
# Cuando está habilitado, los datos del inmueble que el cliente cuenta
# (tipo, dirección, sector/zona/ciudad, precio esperado, matrícula) se
# guardan directo en un deal de consignación en Bitrix (pipeline/CATEGORY_ID
# 34, hardcodeado en app/bitrix/fields.py — no requiere variable de entorno)
# — no en memoria ni en comentarios. Ver la sección del bot en README.md.
WHATSAPP_BOT_ENABLED=false

# Cuántos turnos (usuario+asistente) de historial mandarle al LLM como
# contexto de la conversación (ver app/flows/whatsapp_bot.py).
WHATSAPP_BOT_MAX_HISTORY_TURNS=6

# Opcional: reemplaza el system prompt por defecto (asistente de ventas
# para clientes que quieren vender su apartamento, formal/de usted — ver
# DEFAULT_SYSTEM_PROMPT en app/flows/whatsapp_bot.py).
# WHATSAPP_BOT_SYSTEM_PROMPT=Usted es el asistente de...

# Archivo SQLite donde se persisten el historial de turnos y el deal_id por
# chat (sobreviven a un restart/deploy) — ver app/flows/whatsapp_bot_store.py.
WHATSAPP_BOT_DB_PATH=data/whatsapp_bot.db

# Opcional, para probar en desarrollo sin exponer el bot a todo el mundo:
# lista separada por comas de números permitidos (código de país + número,
# sin "+", mismo formato que app.waha.phone.from_chat_id). Vacío (default)
# no restringe nada.
# WHATSAPP_BOT_ALLOWED_NUMBERS=573001112233,573004445566

# ── Límites de recursos (docker-compose.yml, deploy.resources.limits) ────────
# Pensados para un VPS chico. docker-compose.override.yml (dev local) no los
# aplica — corren sin límite en tu máquina.
API_CPU_LIMIT=1
API_MEMORY_LIMIT=512M
WAHA_CPU_LIMIT=2
WAHA_MEMORY_LIMIT=2G
